#
# Makefile for testing the Faust compiler output
#

system := $(shell uname -s)
system := $(shell echo $(system) | grep MINGW > /dev/null && echo MINGW || echo $(system))
ifeq ($(system), MINGW)
 FAUST ?= ../../build/bin/faust.exe
 COMPARE := ./filesCompare.exe
else
 FAUST ?= ../../build/bin/faust
 COMPARE := ./filesCompare
endif
MAKE ?= make

GCCOPTIONS := -O3 -I../../architecture -I/usr/local/include/ap_fixed -Iarchs -pthread -std=c++11
outdir ?= cpp/double
lang ?= cpp
ext  ?= cpp
arch ?= impulsearch.cpp
precision ?=		# filesCompare precision (empty by default)
FAUSTOPTIONS := -double
SAN ?=
SANFLAGS :=
ifeq ($(SAN),asan)
 SANFLAGS := -fsanitize=address -fno-omit-frame-pointer
endif
ifeq ($(lang), c)
#	CXX = gcc
	ext = c
endif

.PHONY: test 
.DELETE_ON_ERROR:

dspfiles := $(wildcard dsp/*.dsp)
# osc_enable is not tested : the enable and control primitives it uses are being removed
dspfiles := $(filter-out dsp/osc_enable.dsp,$(dspfiles))

listfiles = $(dspfiles:dsp/%.dsp=ir/$1/%.ir)
listintermediate = $(dspfiles:dsp/%.dsp=ir/$1/%) $(dspfiles:dsp/%.dsp=ir/$1/%.cpp) 

TOOLSOPTIONS := -std=c++11 -O3 -I../../architecture
LIB    ?= ../../build/lib/libfaust.a
SRCDIR := tools

all: filesCompare ir/$(outdir) $(call listfiles,$(outdir))

test:
#	$(file > faustoptions.txt, "some text")
	@echo $(call listwebfiles,$(asmjsdir))

help:
	@echo "-------- FAUST impulse response tests --------"
	@echo "Available targets are:"
	@echo " 'all' (default): generate ir for all the dsp files using the given options"
	@echo
	@echo "Options:"
	@echo " 'outdir'       : define the output directory (default to '$(outdir)')"
	@echo " 'lang'         : used for faust -lang option (default to '$(lang)')"
	@echo " 'arch'         : used for faust -a option (default to '$(arch)')"
	@echo " 'FAUSTOPTIONS' : define additional faust options (default to $(FAUSTOPTIONS))"
	@echo " 'precision'    : define filesCompare expected precision (empty by default)"

#########################################################################
# output directories
ir/$(outdir):
	mkdir -p ir/$(outdir)

filesCompare:
	$(MAKE) filesCompare

#########################################################################
# precision issues 

# The tolerance of a program in single precision : one value, applied to every float leg
# (the plain one and every option directory under it, -ftz 2, -vec, -sched, -omp...)
FLOAT_TOLERANCES := \
	carre_volterra:0.002 \
	comb_delay1:0.065 \
	comb_delay2:0.065 \
	cubic_distortion:0.03 \
	lfboost:5e-05 \
	lowcut:1e-05 \
	osc:0.002 \
	osci:0.005 \
	parametric_eq:0.015 \
	phaser_flanger:0.005 \
	spectral_tilt:0.003 \
	tester:8e-05 \
	tester2:3e-06 \
	thru_zero_flanger:0.002 \
	virtual_analog_oscillators:4e-05 \
	zita_rev1:1e-05
tolname = $(word 1,$(subst :, ,$(1)))
tolval  = $(word 2,$(subst :, ,$(1)))
$(foreach t,$(FLOAT_TOLERANCES),$(eval ir/$(lang)/float/$(call tolname,$(t)).ir: precision=$(call tolval,$(t))))
$(foreach t,$(FLOAT_TOLERANCES),$(eval ir/$(lang)/float/%/$(call tolname,$(t)).ir: precision=$(call tolval,$(t))))

ir/c/double/sched/parametric_eq.ir:		precision=0.004
ir/cpp/double/sched/parametric_eq.ir: 	precision=0.04

# the drivers without the two polyphonic runs print half of the samples (their header says
# so) : they are compared with the first half of the reference, 30000 samples exactly
HALF_ARCHS := impulsearch6.cpp impulsearch7bis.cpp impulsearch7qua.cpp impulsearch8.cpp \
              impulsearch8bis.cpp impulsearch8ter.cpp impulsearch9.cpp impulsearch9bis.cpp \
              impulsearch9ter.cpp impulsearch9qua.cpp impulsearch10.cpp impulsearch10bis.cpp
ifneq ($(filter $(arch),$(HALF_ARCHS)),)
PART := -part 30000
endif

#########################################################################
# rules 
ir/$(outdir)/%.ir: ir/$(outdir)/% reference/%.ir
	$< -n 60000 > $@
	$(COMPARE) $@ reference/$(notdir $@) $(precision) $(PART)
	
ir/$(outdir)/% : ir/$(outdir)/%.$(ext)
	$(CXX) $(GCCOPTIONS) $(SANFLAGS) $< -o $@

# Specific rule to test 'control' primitive that currently uses the -lang ocpp backend (still compiling in scalar mode...)
ir/$(outdir)/control.cpp : dsp/control.dsp | ir/$(outdir)
	@echo "Can only be tested in scalar mode"
	$(FAUST) -lang $(lang) -double -i -A ../../architecture -a archs/$(arch) $< -o $@

ir/$(outdir)/prefix.ir:
	echo "todo fix bug #1071 to test dsp/prefix.dsp"

ir/cpp/double/mapp/constant.ir:
	echo "todo fix bug #1074 to test dsp/constant.dsp"

# -os and -ec do not allow the foreign variable 'count' that bs.dsp reads : not tested there
ifneq ($(filter -os -ec,$(FAUSTOPTIONS)),)
ir/$(outdir)/bs.ir:
	@echo "bs.dsp not tested with -os or -ec : accessing foreign variable 'count' is not allowed in this compilation mode"
endif

ir/$(outdir)/%.$(ext) : dsp/%.dsp | ir/$(outdir)
	$(FAUST) -lang $(lang) $(FAUSTOPTIONS) -i -A ../../architecture -a archs/$(arch) $< -o $@
