#
# Makefile for testing the Faust compiler output
#

system := $(shell uname -s)
system := $(shell echo $(system) | grep MINGW > /dev/null && echo MINGW || echo $(system))
ifeq ($(system), MINGW)
 FAUST ?= ../../build/bin/faust.exe
 COMPARE := ./filesCompare.exe
else
 FAUST ?= ../../build/bin/faust
 COMPARE := ./filesCompare
endif
MAKE ?= make

GCCOPTIONS := -O3 -I../../architecture -I/usr/local/include/ap_fixed -Iarchs -pthread -std=c++11
outdir ?= cpp/double
lang ?= cpp
ext  ?= cpp
arch ?= impulsearch.cpp
precision ?=		# filesCompare precision (empty by default)
FAUSTOPTIONS := -double
SAN ?=
SANFLAGS :=
ifeq ($(SAN),asan)
 SANFLAGS := -fsanitize=address -fno-omit-frame-pointer
endif
ifeq ($(lang), c)
#	CXX = gcc
	ext = c
endif

.PHONY: test 
.DELETE_ON_ERROR:

dspfiles := $(wildcard dsp/*.dsp)

listfiles = $(dspfiles:dsp/%.dsp=ir/$1/%.ir)
listintermediate = $(dspfiles:dsp/%.dsp=ir/$1/%) $(dspfiles:dsp/%.dsp=ir/$1/%.cpp) 

TOOLSOPTIONS := -std=c++11 -O3 -I../../architecture
LIB    ?= ../../build/lib/libfaust.a
SRCDIR := tools

all: filesCompare ir/$(outdir) $(call listfiles,$(outdir))

test:
#	$(file > faustoptions.txt, "some text")
	@echo $(call listwebfiles,$(asmjsdir))

help:
	@echo "-------- FAUST impulse response tests --------"
	@echo "Available targets are:"
	@echo " 'all' (default): generate ir for all the dsp files using the given options"
	@echo
	@echo "Options:"
	@echo " 'outdir'       : define the output directory (default to '$(outdir)')"
	@echo " 'lang'         : used for faust -lang option (default to '$(lang)')"
	@echo " 'arch'         : used for faust -a option (default to '$(arch)')"
	@echo " 'FAUSTOPTIONS' : define additional faust options (default to $(FAUSTOPTIONS))"
	@echo " 'precision'    : define filesCompare expected precision (empty by default)"

#########################################################################
# output directories
ir/$(outdir):
	mkdir -p ir/$(outdir)

filesCompare:
	$(MAKE) filesCompare

#########################################################################
# precision issues

# Float legs (-single) are compared with the double reference set, at an
# absolute tolerance (filesCompare, default 2e-6). Single precision cannot
# meet 2e-6 on a resonant filter, a phase accumulator, or values above 16
# (the ulp of a float at 16 is 2e-6). And the four-voice polyphonic run of
# the driver sums four identical voices, which multiplies every rounding
# error by four. One table applies to every float leg of every language,
# whatever its options : the pattern below matches ir/cpp/float/osc.ir as
# well as ir/ocpp/float/vec/lv1/osc.ir.
#
# Each value is twice the largest delta measured over the legs cpp/float,
# cpp/float/vec, cpp/float/omp, ocpp/float, ocpp/float/mcd0,
# ocpp/float/vec/lv0, ocpp/float/vec/lv1, c/float and c/float/vec, rounded
# up to one digit (2026-10-24, 48cb8aeb2, Linux x86-64, g++ 13.3,
# -ffp-contract=off). The largest delta was the same on all nine legs. For
# each of these programs, the single-precision code retyped to double
# (float -> double, float literals and float libm calls included) matches
# the reference: the deltas come from rounding, not from the structure of
# the code. A different libm may need more margin; a value raised for that
# reason should say so here.
#
# comb_delay1 and comb_delay2 read a delay line at an index computed in
# float : one ulp moves the index by one sample, which changes the output
# by at most one step of osc(440), 2*pi*440/44100 = 0.0627, times four
# voices = 0.2508.
#
# grain3, table and table2 have no entry : their output depends
# discontinuously on a float value (a trigger threshold, a table index), so
# a different rounding gives an unrelated sample and no tolerance short of
# the signal amplitude would pass. They are accepted failures of the float
# legs, listed in tests/TESTING.md.

float_precision_bells                      := 0.002
float_precision_carre_volterra             := 0.0006
float_precision_comb_bug_exp               := 0.004
float_precision_comb_delay1                := 0.26
float_precision_comb_delay2                := 0.26
float_precision_cubic_distortion           := 0.007
float_precision_lfboost                    := 0.000008
float_precision_long_convolution           := 0.002
float_precision_lowcut                     := 0.000008
float_precision_math                       := 0.007
float_precision_modulations                := 0.05
float_precision_osc                        := 0.005
float_precision_osci                       := 0.005
float_precision_parametric_eq              := 0.005
float_precision_phaser_flanger             := 0.003
float_precision_pow                        := 0.02
float_precision_priority                   := 0.009
float_precision_priority1                  := 0.00002
float_precision_spectral_tilt              := 0.001
float_precision_tester                     := 0.0003
float_precision_tester2                    := 0.00001
float_precision_tf_exp                     := 0.000004
float_precision_thru_zero_flanger          := 0.003
float_precision_virtual_analog_oscillators := 0.00007
float_precision_vocal_impulse_train        := 0.0002
float_precision_zita_rev1                  := 0.00002

ir/$(lang)/float/%.ir: precision = $(float_precision_$(basename $(notdir $@)))

ir/c/double/sched/parametric_eq.ir:		precision=0.004
ir/cpp/double/sched/parametric_eq.ir: 	precision=0.04

#########################################################################
# rules 
ir/$(outdir)/%.ir: ir/$(outdir)/% reference/%.ir
	$< -n 60000 > $@
	$(COMPARE) $@ reference/$(notdir $@) $(precision)
	
ir/$(outdir)/% : ir/$(outdir)/%.$(ext)
	$(CXX) $(GCCOPTIONS) $(SANFLAGS) $< -o $@

# Specific rule to test 'control' primitive that currently uses the -lang ocpp backend (still compiling in scalar mode...)
ir/$(outdir)/control.cpp : dsp/control.dsp | ir/$(outdir)
	@echo "Can only be tested in scalar mode"
	$(FAUST) -lang $(lang) -double -i -A ../../architecture -a archs/$(arch) $< -o $@

ir/cpp/double/os/osc_enable.ir:
	@echo "osc_enable test is broken with flag -os"

# Specific rule to test 'enable/control' primitives that currently only work in scalar mode, used for 'cpp', 'c' and 'travis'
ir/$(outdir)/osc_enable.$(ext) : dsp/osc_enable.dsp | ir/$(outdir)
	@echo "Can only be tested in scalar mode"
	$(FAUST) -lang $(lang) -double -i -A ../../architecture -a archs/$(arch) $< -o $@

# Three rules for -c1 (= -os) mode
# Specific rule to test 'enable/control' primitives that currently only work in scalar mode
ir/c1/double/osc_enable.c : dsp/osc_enable.dsp | ir/$(outdir)
	@echo "Can only be tested in scalar mode"
	$(FAUST) -lang $(lang) -double -os -i -A ../../architecture -a archs/$(arch) $< -o $@

# Specific rule to test 'enable/control' primitives that currently only work in scalar mode
ir/c1/double/dlt0/osc_enable.c : dsp/osc_enable.dsp | ir/$(outdir)
	@echo "Can only be tested in scalar mode"
	$(FAUST) -lang $(lang) -double -os -i -A ../../architecture -a archs/$(arch) $< -o $@

# Specific rule to test 'enable/control' primitives that currently only work in scalar mode
ir/c1/double/dlt256/osc_enable.c : dsp/osc_enable.dsp | ir/$(outdir)
	@echo "Can only be tested in scalar mode"
	$(FAUST) -lang $(lang) -double -os -i -A ../../architecture -a archs/$(arch) $< -o $@

ir/$(outdir)/prefix.ir:
	echo "todo fix bug #1071 to test dsp/prefix.dsp"

ir/cpp/double/mapp/constant.ir:
	echo "todo fix bug #1074 to test dsp/constant.dsp"

ir/cpp/double/os/bs.ir:
	@echo "accessing foreign variable 'count' is not allowed in this compilation mode"

ir/$(outdir)/%.$(ext) : dsp/%.dsp | ir/$(outdir)
	$(FAUST) -lang $(lang) $(FAUSTOPTIONS) -i -A ../../architecture -a archs/$(arch) $< -o $@
