E0  = min(1.92e+05f, max(5e+01f, float(fSamplingFreq)));                                // real konst [50, 192000] lsb -27
E1  = tan(1776.5707f/E0);                                                               // real konst [-inf, inf]  <-- unbounded from here
E2  = 1.0f/E1;                                                                          // real konst [-inf, inf]
E3  = -E2;                                                                              // real konst [-inf, inf]
E4  = pow(E1, 2.0f);                                                                    // real konst [-inf, inf]
E5  = 1.0f/E4;                                                                          // real konst [-inf, inf]
E6  = 1.0f+E5;                                                                          // real konst [-inf, inf]
E7  = E2+E6;                                                                            // real konst [-inf, inf] invalid  <-- invalid from unbounded operands
E8  = (E3+E6)/E7;                                                                       // real konst [-inf, inf] invalid
E9  = 2.0f/E7*R0';                                                                      // real samp [-inf, inf] invalid
E10 = tan(3553.1414f/E0);                                                               // real konst [-inf, inf]  <-- unbounded from here
E11 = pow(E10, 2.0f);                                                                   // real konst [-inf, inf]
E12 = 1.0f/E10;                                                                         // real konst [-inf, inf]
E13 = 1.0f/E11;                                                                         // real konst [-inf, inf]
E14 = 1.0f+E13;                                                                         // real konst [-inf, inf]
E15 = E12+E14;                                                                          // real konst [-inf, inf] invalid  <-- invalid from unbounded operands
E16 = E11*E15;                                                                          // real konst [-inf, inf] invalid
E17 = 1.0f+E12;                                                                         // real konst [-inf, inf]
E18 = float(1-1');                                                                      // real samp [0, 1] lsb -1
E19 = -E12;                                                                             // real konst [-inf, inf]
E20 = -((1.0f+E19)/E17);                                                                // real konst [-inf, inf] invalid
E21 = -(2.0f*((1.0f-E13)/E15));                                                         // real konst [-inf, inf] invalid
E22 = -((E19+E14)/E15);                                                                 // real konst [-inf, inf] invalid
E23 = 1.0f/(E10*E17)*IIR(IIR(FIR(E18; 1.0f, -1.0f); E20); E21, E22);                    // real samp [-inf, inf] invalid
E24 = 1.0f/E16;                                                                         // real konst [-inf, inf] invalid
R0  = -(E8*R0@2)-mix(E5, E9, 2.0f*(E4/E16)*E23')+FIR(E23; E24, 0.0f, E24);              // real samp [-inf, inf] invalid
E25 = 1.0f+E2;                                                                          // real konst [-inf, inf]
E26 = 1.0f/E15;                                                                         // real konst [-inf, inf] invalid
E27 = FIR(1.0f/E17*IIR(IIR(FIR(E18; 1.0f, 1.0f); E20); E21, E22); E26, 2.0f/E15, E26);  // real samp [-inf, inf] invalid
E28 = E27';                                                                             // real samp [-inf, inf] invalid
E29 = -((1.0f+E3)/E25);                                                                 // real konst [-inf, inf] invalid
E30 = -(2.0f*((1.0f-E5)/E7));                                                           // real konst [-inf, inf] invalid
E31 = -E8;                                                                              // real konst [-inf, inf] invalid
E32 = E4*E7;                                                                            // real konst [-inf, inf] invalid
E33 = 1.0f/E32;                                                                         // real konst [-inf, inf] invalid
E34 = 1.0f/E25*IIR(IIR(E27+E28; E29); E30, E31);                                        // real samp [-inf, inf] invalid
E35 = 1.0f/E7;                                                                          // real konst [-inf, inf] invalid
// real samp [-inf, inf] invalid
process = (FIR(R0; E8, 0.0f, 1.0f)+FIR(1.0f/(E1*E25)*IIR(IIR(-E28+E27; E29); E30, E31); E33, -(2.0f/E32), E33)+FIR(E34; E35, 0.0f, E35)+mix(E5, E9, 2.0f*(E4/E7)*E34'));
