		ui_interface->declare(&fslider4, "scale", "log");
		ui_interface->declare(&fslider4, "style", "knob");
		ui_interface->declare(&fslider4, "tooltip", "Crossover frequency (Hz) separating low and middle frequencies");
		ui_interface->declare(&fslider4, "unit", "Hz");
		ui_interface->addVerticalSlider("LF X", &fslider4, 2e+02f, 5e+01f, 1e+03f, 1.0f);
