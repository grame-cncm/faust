	virtual void compute (int count, FAUSTFLOAT** input, FAUSTFLOAT** output) {
		float 	fSlow0 = expf(-(fConst1 / fmaxf(1.0f, fminf(1e+04f, float(fslider0))))); // step: 16
		int 	iSlow1 = int(+float(+(float(fcheckbox0) > 0.0f))); // step: 92
		int 	iSlow2 = int(+float(+(float(fcheckbox1) > 0.0f))); // step: 96
		float 	fSlow3 = powf(1e+01f,(0.05f * fmaxf(-1.2e+02f, fminf(1e+01f, float(fslider1))))); // step: 105
		float 	fVeeec0;
		int 	iSlow4 = int(+float(+(float(fcheckbox2) > 0.0f))); // step: 113
		int 	iSlow5 = int(+float(+(float(fcheckbox3) > 0.0f))); // step: 117
		int 	iSlow6 = int(+float(+(float(fcheckbox4) > 0.0f))); // step: 121
		int 	iVeeec1;
		float 	fVeeec2[4];
		float 	fVec0[4];
		int 	iSlow7 = int(+(-1.0f + fmaxf(1.0f, fminf(4.0f, float(fentry0))))); // step: 147
		int 	iSlow8 = (iSlow7 >= 2); // step: 148
		int 	iVeeec9[4];
		int 	iSlow9 = (iSlow7 >= 1); // step: 153
		float 	fSlow10 = powf(2.0f,(0.083333336f * (-49.0f + fmaxf(1.0f, fminf(88.0f, float(fslider2)))))); // step: 167
		float 	fSlow11 = expf(-(fConst30 / fmaxf(0.001f, fminf(1e+01f, float(fslider3))))); // step: 173
		float 	fSlow12 = ((1.0f - fSlow11) * fSlow10); // step: 174
		float 	fVeeec12;
		float 	fVeeec11;
		float 	fVeeec15[2];
		int 	iSlow13 = (iSlow7 >= 3); // step: 196
		float 	fVeeec16[2];
		float 	fVeeec17[2];
		float 	fVeeec18[2];
		float 	fVeeec19[2];
		float 	fVeeec20[2];
		float 	fSlow14 = (1.0f + (0.01f * fmaxf(-1e+01f, fminf(1e+01f, float(fslider4))))); // step: 245
		float 	fVeeec21;
		float 	fVeeec23[2];
		float 	fVeeec24[2];
		float 	fVeeec25[2];
		float 	fVeeec26[2];
		float 	fVeeec27[2];
		float 	fVeeec28[2];
		float 	fSlow15 = (1.0f + (0.01f * fmaxf(-1e+01f, fminf(1e+01f, float(fslider5))))); // step: 302
		float 	fVeeec29;
		float 	fVeeec31[2];
		float 	fVeeec32[2];
		float 	fVeeec33[2];
		float 	fVeeec34[2];
		float 	fVeeec35[2];
		float 	fVeeec36[2];
		float 	fSlow16 = powf(1e+01f,(0.05f * fmaxf(-6e+01f, fminf(1e+01f, float(fslider6))))); // step: 366
		float 	fSlow17 = fmaxf(0.0f, fminf(1.0f, float(fslider7))); // step: 375
		float 	fSlow18 = ((int(+float(+(float(fcheckbox5) > 0.0f)))) ? -fSlow17 : fSlow17); // step: 377
		float 	fSlow19 = fmaxf(-0.999f, fminf(0.999f, float(fslider8))); // step: 383
		float 	fSlow20 = (0.001f * fmaxf(0.0f, fminf(2e+01f, float(fslider9)))); // step: 390
		float 	fSlow21 = fmaxf(0.0f, fminf(2e+01f, float(fslider10))); // step: 394
		float 	fSlow22 = (fConst42 * fmaxf(0.0f, fminf(1e+01f, float(fslider11)))); // step: 401
		float 	fSlow23 = sinf(fSlow22); // step: 402
		float 	fSlow24 = cosf(fSlow22); // step: 405
		float 	fVeeec38;
		float 	fSlow25 = (0.0005f * fSlow21); // step: 411
		float 	fVeeec37;
		float 	fSlow26 = powf(1e+01f,(0.05f * fmaxf(-6e+01f, fminf(1e+01f, float(fslider12))))); // step: 438
		float 	fSlow27 = (0.5f * ((int(+float(+(float(fcheckbox6) > 0.0f)))) ? 2.0f : fmaxf(0.0f, fminf(1.0f, float(fslider13))))); // step: 447
		float 	fSlow28 = -fSlow27; // step: 448
		float 	fSlow29 = (fSlow26 * (1.0f - fSlow27)); // step: 450
		float 	fSlow30 = ((int(+float(+(float(fcheckbox7) > 0.0f)))) ? fSlow28 : fSlow27); // step: 457
		float 	fSlow31 = expf(-(fConst43 * fmaxf(1e+01f, fminf(5e+03f, float(fslider14))))); // step: 467
		float 	fSlow32 = fmaxf(1.1f, fminf(4.0f, float(fslider15))); // step: 472
		float 	fSlow33 = powf(fSlow32,4.0f); // step: 473
		float 	fSlow34 = fmaxf(2e+01f, fminf(5e+03f, float(fslider16))); // step: 476
		float 	fSlow35 = (6.2831855f * fSlow34); // step: 477
		float 	fSlow36 = fmaxf(fSlow34, fmaxf(2e+01f, fminf(1e+04f, float(fslider17)))); // step: 483
		float 	fSlow37 = (fSlow34 - fSlow36); // step: 483
		float 	fSlow38 = (fConst42 * fmaxf(0.0f, fminf(1e+01f, float(fslider18)))); // step: 488
		float 	fSlow39 = sinf(fSlow38); // step: 489
		float 	fSlow40 = cosf(fSlow38); // step: 492
		float 	fVeeec46;
		float 	fSlow41 = (3.1415927f * fSlow37); // step: 499
		float 	fSlow42 = (fConst30 * fSlow33); // step: 502
		float 	fSlow43 = (2.0f * fSlow31); // step: 505
		float 	fSlow44 = powf(fSlow31,2.0f); // step: 507
		float 	fSlow45 = powf(fSlow32,3.0f); // step: 511
		float 	fSlow46 = (fConst30 * fSlow45); // step: 512
		float 	fSlow47 = powf(fSlow32,2.0f); // step: 524
		float 	fSlow48 = (fConst30 * fSlow47); // step: 525
		float 	fSlow49 = (fConst30 * fSlow32); // step: 537
		float 	fSlow50 = fmaxf(-0.999f, fminf(0.999f, float(fslider19))); // step: 550
		float 	fSlow51 = (2.0f * fSlow31); // step: 552
		float 	fVeeec54[3];
		float 	fVeeec52[3];
		float 	fVeeec50[3];
		float 	fVeeec45[3];
		float 	fVeeec44;
		float 	fVeeec39;
		float 	fSlow52 = (0.0005f * fSlow21); // step: 590
		float 	fVeeec62;
		float 	fVeeec47;
		float 	fSlow53 = (3.1415927f * fSlow37); // step: 625
		float 	fSlow54 = (fConst30 * fSlow33); // step: 628
		float 	fSlow55 = (2.0f * fSlow31); // step: 631
		float 	fSlow56 = (fConst30 * fSlow45); // step: 636
		float 	fSlow57 = (fConst30 * fSlow47); // step: 648
		float 	fSlow58 = (fConst30 * fSlow32); // step: 660
		float 	fSlow59 = (2.0f * fSlow31); // step: 672
		float 	fVeeec75[3];
		float 	fVeeec73[3];
		float 	fVeeec71[3];
		float 	fVeeec68[3];
		float 	fVeeec67;
