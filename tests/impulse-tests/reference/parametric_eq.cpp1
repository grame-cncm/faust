		m->declare("oscillator.lib/version", "1.11");
	}

	virtual int getNumInputs() { return 1; }
	virtual int getNumOutputs() { return 2; }
	static void classInit(int sample_rate) {
	}
	virtual void instanceConstants(int sample_rate) {
		fSampleRate = sample_rate;
		fConst0 = fminf(1.92e+05f, fmaxf(5e+01f, float(+fSampleRate))); // step: 12
		fConst1 = (1e+03f / fConst0); // step: 13
		fConst2 = tanf((50265.484f / fConst0)); // step: 21
		fConst3 = powf(fConst2,2.0f); // step: 22
		fConst4 = (50.06381f / fConst3); // step: 24
		fConst5 = (0.15748216f / fConst2); // step: 27
		fConst6 = (1.0f / fConst3); // step: 28
		fConst7 = (fConst6 + 0.9351402f); // step: 29
		fConst8 = (fConst5 + fConst7); // step: 30
		fConst9 = ((0.9351402f + fConst4) / fConst8); // step: 31
		fConst10 = (2.0f * ((0.9351402f - fConst4) / fConst8)); // step: 35
		fConst11 = -fConst6; // step: 36
		fConst12 = -(2.0f * ((0.9351402f - fConst6) / fConst8)); // step: 40
		fConst13 = -((fConst7 - fConst5) / fConst8); // step: 44
		fConst14 = (11.0520525f / fConst3); // step: 47
		fConst15 = (0.74313045f / fConst2); // step: 50
		fConst16 = (fConst6 + 1.4500711f); // step: 51
		fConst17 = (fConst15 + fConst16); // step: 52
		fConst18 = ((1.4500711f + fConst14) / fConst17); // step: 53
		fConst19 = (2.0f * ((1.4500711f - fConst14) / fConst17)); // step: 57
		fConst20 = -(2.0f * ((1.4500711f - fConst6) / fConst17)); // step: 61
		fConst21 = -((fConst16 - fConst15) / fConst17); // step: 65
		fConst22 = (0.0017661728f / fConst3); // step: 68
		fConst23 = (3.1897273f / fConst2); // step: 71
		fConst24 = (4.0767817f + fConst6); // step: 73
		fConst25 = (fConst23 + fConst24); // step: 74
		fConst26 = ((0.0004076782f + fConst22) / fConst25); // step: 75
		fConst27 = (2.0f * ((0.0004076782f - fConst22) / fConst25)); // step: 79
		fConst28 = -(2.0f * ((4.0767817f - fConst6) / fConst25)); // step: 83
		fConst29 = -((fConst24 - fConst23) / fConst25); // step: 87
		fConst30 = (3.1415927f / fConst0); // step: 93
		fConst31 = (1382.3008f / fConst0); // step: 118
		fConst32 = (2764.6016f / fConst0); // step: 151
		fConst33 = (1.0f / fConst0); // step: 264
		fConst34 = (0.25f * fConst0); // step: 299
		fConst35 = powf(fConst0,2.0f); // step: 302
		fConst36 = (0.041666668f * fConst35); // step: 320
		fConst37 = powf(fConst0,3.0f); // step: 321
		fConst38 = (0.0052083335f * fConst37); // step: 340
		fConst39 = (0.25f * fConst0); // step: 367
		fConst40 = (0.041666668f * fConst35); // step: 383
		fConst41 = (0.0052083335f * fConst37); // step: 399
		fConst42 = (0.25f * fConst0); // step: 424
		fConst43 = (0.041666668f * fConst35); // step: 440
		fConst44 = (0.0052083335f * fConst37); // step: 456
		fConst45 = (2.0f * ((4.0767817f - fConst6) / fConst25)); // step: 521
		fConst46 = ((fConst24 - fConst23) / fConst25); // step: 521
		fConst47 = (2.0f * ((1.4500711f - fConst6) / fConst17)); // step: 523
		fConst48 = ((fConst16 - fConst15) / fConst17); // step: 523
		fConst49 = (2.0f * ((0.9351402f - fConst6) / fConst8)); // step: 525
		fConst50 = ((fConst7 - fConst5) / fConst8); // step: 525
		fConst51 = tanf((12566.371f / fConst0)); // step: 531
		fConst52 = powf(fConst51,2.0f); // step: 532
		fConst53 = (50.06381f / fConst52); // step: 533
		fConst54 = (0.15748216f / fConst51); // step: 535
		fConst55 = (1.0f / fConst52); // step: 536
		fConst56 = (0.9351402f + fConst55); // step: 537
		fConst57 = (fConst54 + fConst56); // step: 538
		fConst58 = ((0.9351402f + fConst53) / fConst57); // step: 539
