		fConst1165 = (2.0f * ((0.9351402f - fConst555) / fConst1140)); // step: 2767
		fConst1166 = ((fConst1139 - fConst1138) / fConst1140); // step: 2767
		fConst1167 = (0.16840488f / fConst985); // step: 2772
		fConst1168 = (1.0693583f + fConst989); // step: 2773
		fConst1169 = (fConst1167 + fConst1168); // step: 2774
		fConst1170 = ((53.53615f + fConst989) / fConst1169); // step: 2775
		fConst1171 = (2.0f * ((53.53615f - fConst989) / fConst1169)); // step: 2778
		fConst1172 = -(2.0f * ((1.0693583f - fConst989) / fConst1169)); // step: 2782
		fConst1173 = -((fConst1168 - fConst1167) / fConst1169); // step: 2786
		fConst1174 = (0.51247865f / fConst985); // step: 2788
		fConst1175 = (0.6896214f + fConst989); // step: 2789
		fConst1176 = (fConst1174 + fConst1175); // step: 2790
		fConst1177 = ((7.6217313f + fConst989) / fConst1176); // step: 2791
		fConst1178 = (2.0f * ((7.6217313f - fConst989) / fConst1176)); // step: 2794
		fConst1179 = -(2.0f * ((0.6896214f - fConst989) / fConst1176)); // step: 2798
		fConst1180 = -((fConst1175 - fConst1174) / fConst1176); // step: 2802
		fConst1181 = (0.0001f / fConst986); // step: 2803
		fConst1182 = (0.78241307f / fConst985); // step: 2805
		fConst1183 = (0.2452915f + fConst989); // step: 2806
		fConst1184 = (fConst1182 + fConst1183); // step: 2807
		fConst1185 = ((0.0004332272f + fConst1181) / fConst1184); // step: 2808
		fConst1186 = (2.0f * ((0.0004332272f - fConst1181) / fConst1184)); // step: 2812
		fConst1187 = -(2.0f * ((0.2452915f - fConst989) / fConst1184)); // step: 2816
		fConst1188 = -((fConst1183 - fConst1182) / fConst1184); // step: 2820
		fConst1189 = (2.0f * ((0.2452915f - fConst989) / fConst1184)); // step: 2821
		fConst1190 = ((fConst1183 - fConst1182) / fConst1184); // step: 2821
		fConst1191 = (2.0f * ((0.6896214f - fConst989) / fConst1176)); // step: 2823
		fConst1192 = ((fConst1175 - fConst1174) / fConst1176); // step: 2823
		fConst1193 = (2.0f * ((1.0693583f - fConst989) / fConst1169)); // step: 2825
		fConst1194 = ((fConst1168 - fConst1167) / fConst1169); // step: 2825
	}
