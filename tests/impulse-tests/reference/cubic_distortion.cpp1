		fConst837 = ((fConst830 - fConst829) / fConst831); // step: 1796
		fConst838 = (2.0f * ((1.4500711f - fConst226) / fConst823)); // step: 1798
		fConst839 = ((fConst822 - fConst821) / fConst823); // step: 1798
		fConst840 = (2.0f * ((0.9351402f - fConst226) / fConst815)); // step: 1800
		fConst841 = ((fConst814 - fConst813) / fConst815); // step: 1800
		fConst842 = (50.06381f / fConst383); // step: 1804
		fConst843 = (0.15748216f / fConst382); // step: 1806
		fConst844 = (0.9351402f + fConst384); // step: 1807
		fConst845 = (fConst843 + fConst844); // step: 1808
		fConst846 = ((0.9351402f + fConst842) / fConst845); // step: 1809
		fConst847 = (2.0f * ((0.9351402f - fConst842) / fConst845)); // step: 1813
		fConst848 = -(2.0f * ((0.9351402f - fConst384) / fConst845)); // step: 1817
		fConst849 = -((fConst844 - fConst843) / fConst845); // step: 1821
		fConst850 = (11.0520525f / fConst383); // step: 1822
		fConst851 = (0.74313045f / fConst382); // step: 1824
		fConst852 = (1.4500711f + fConst384); // step: 1825
		fConst853 = (fConst851 + fConst852); // step: 1826
		fConst854 = ((1.4500711f + fConst850) / fConst853); // step: 1827
		fConst855 = (2.0f * ((1.4500711f - fConst850) / fConst853)); // step: 1831
		fConst856 = -(2.0f * ((1.4500711f - fConst384) / fConst853)); // step: 1835
		fConst857 = -((fConst852 - fConst851) / fConst853); // step: 1839
		fConst858 = (0.0017661728f / fConst383); // step: 1840
		fConst859 = (3.1897273f / fConst382); // step: 1842
		fConst860 = (4.0767817f + fConst384); // step: 1843
		fConst861 = (fConst859 + fConst860); // step: 1844
		fConst862 = ((0.0004076782f + fConst858) / fConst861); // step: 1845
		fConst863 = (2.0f * ((0.0004076782f - fConst858) / fConst861)); // step: 1849
		fConst864 = -(2.0f * ((4.0767817f - fConst384) / fConst861)); // step: 1853
		fConst865 = -((fConst860 - fConst859) / fConst861); // step: 1857
		fConst866 = (2.0f * ((4.0767817f - fConst384) / fConst861)); // step: 1858
		fConst867 = ((fConst860 - fConst859) / fConst861); // step: 1858
		fConst868 = (2.0f * ((1.4500711f - fConst384) / fConst853)); // step: 1860
		fConst869 = ((fConst852 - fConst851) / fConst853); // step: 1860
		fConst870 = (2.0f * ((0.9351402f - fConst384) / fConst845)); // step: 1862
		fConst871 = ((fConst844 - fConst843) / fConst845); // step: 1862
	}
