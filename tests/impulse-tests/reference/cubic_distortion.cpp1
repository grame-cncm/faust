	virtual void compute (int count, FAUSTFLOAT** input, FAUSTFLOAT** output) {
		int 	iVec0[2];
		float 	fSlow0 = powf(2.0f,(0.083333336f * (-49.0f + fmaxf(1.0f, fminf(88.0f, float(fslider0)))))); // step: 26
		float 	fSlow1 = expf(-(fConst2 / fmaxf(0.001f, fminf(1e+01f, float(fslider1))))); // step: 35
		float 	fSlow2 = ((1.0f - fSlow1) * fSlow0); // step: 36
		float 	fVeeec2;
		float 	fVeeec0;
		float 	fSlow3 = fmaxf(0.0f, fminf(1.0f, float(fslider2))); // step: 52
		float 	fVeeec4;
		float 	fSlow4 = fmaxf(0.0f, fminf(1.0f, float(fslider3))); // step: 57
		float 	fVeeec5;
		int 	iSlow5 = int(+float(+(float(fcheckbox0) > 0.0f))); // step: 65
		float 	fSlow6 = powf(1e+01f,(0.05f * fmaxf(-1.2e+02f, fminf(1e+01f, float(fslider4))))); // step: 72
		float 	fVeeec6;
		float 	fVeeec3;
		float 	fVeeec8[2];
		float 	fSlow7 = expf(-(fConst3 / fmaxf(1.0f, fminf(1e+04f, float(fslider5))))); // step: 102
		float 	fVeeec9;
		float 	fVeeec10[3];
		float 	fVeeec15[3];
		float 	fVeeec20[3];
		float 	fVeeec25;
		float 	fVeeec26[3];
		float 	fVeeec31[3];
		float 	fVeeec36[3];
		float 	fVeeec41[3];
		float 	fVeeec46[3];
		float 	fVeeec51[3];
		float 	fVeeec56[3];
		float 	fVeeec61[3];
		float 	fVeeec66[3];
		float 	fVeeec71[3];
		float 	fVeeec76[3];
		float 	fVeeec81[3];
		float 	fVeeec86[3];
		float 	fVeeec91[3];
		float 	fVeeec96[3];
		float 	fVeeec101;
		float 	fVeeec102[3];
		float 	fVeeec107[3];
		float 	fVeeec112[3];
		float 	fVeeec117[3];
		float 	fVeeec122[3];
		float 	fVeeec127[3];
		float 	fVeeec132[3];
		float 	fVeeec137[3];
		float 	fVeeec142[3];
		float 	fVeeec147[3];
