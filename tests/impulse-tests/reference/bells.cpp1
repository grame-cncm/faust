		ui_interface->addNumEntry("feedback", &fentry1, 0.989f, 0.0f, 1.0f, 0.001f);
		ui_interface->addNumEntry("pitch0", &fentry0, 6e+01f, 6e+01f, 1.6e+02f, 0.01f);
