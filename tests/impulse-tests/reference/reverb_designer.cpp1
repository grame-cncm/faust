	virtual int getNumInputs() { return 2; }
	virtual int getNumOutputs() { return 2; }
	static void classInit(int sample_rate) {
	}
	virtual void instanceConstants(int sample_rate) {
		fSampleRate = sample_rate;
		fConst0 = fminf(1.92e+05f, fmaxf(5e+01f, float(+fSampleRate))); // step: 21
		fConst1 = (0.002915452f * fConst0); // step: 28
		fConst2 = (6.9077554f / fConst0); // step: 92
		fConst3 = (3.1415927f / fConst0); // step: 106
		fConst4 = (0.002915452f * fConst0); // step: 421
		fConst5 = (0.002915452f * fConst0); // step: 611
		fConst6 = (0.002915452f * fConst0); // step: 800
		fConst7 = (0.002915452f * fConst0); // step: 991
		fConst8 = (0.002915452f * fConst0); // step: 1180
		fConst9 = (0.002915452f * fConst0); // step: 1370
		fConst10 = (0.002915452f * fConst0); // step: 1559
		fConst11 = (0.002915452f * fConst0); // step: 1751
		fConst12 = (0.002915452f * fConst0); // step: 1940
		fConst13 = (0.002915452f * fConst0); // step: 2130
		fConst14 = (0.002915452f * fConst0); // step: 2319
		fConst15 = (0.002915452f * fConst0); // step: 2510
		fConst16 = (0.002915452f * fConst0); // step: 2699
		fConst17 = (0.002915452f * fConst0); // step: 2889
		fConst18 = (0.002915452f * fConst0); // step: 3075
	}
