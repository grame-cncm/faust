	virtual void compute (int count, FAUSTFLOAT** input, FAUSTFLOAT** output) {
		float 	fSlow0 = expf(-(fConst1 / fmaxf(1.0f, fminf(1e+04f, float(fslider0))))); // step: 16
		int 	iSlow1 = int(+float(+(float(fcheckbox0) > 0.0f))); // step: 92
		float 	fSlow2 = fmaxf(0.0f, fminf(1.0f, float(fslider1))); // step: 96
		float 	fSlow3 = powf(1e+01f,(0.05f * fmaxf(-1.2e+02f, fminf(1e+01f, float(fslider2))))); // step: 107
		float 	fVeeec0;
		float 	fSlow4 = fmaxf(0.0f, fminf(1.0f, float(fslider3))); // step: 112
		int 	iVeeec1;
		float 	fVeeec2[4];
		float 	fVec0[4];
		float 	fSlow5 = fmaxf(0.0f, fminf(1.0f, float(fslider4))); // step: 132
		int 	iSlow6 = int(+(-1.0f + fmaxf(1.0f, fminf(4.0f, float(fentry0))))); // step: 140
		int 	iSlow7 = (iSlow6 >= 2); // step: 141
		int 	iVeeec9[4];
		int 	iSlow8 = (iSlow6 >= 1); // step: 146
		float 	fSlow9 = powf(2.0f,(0.083333336f * (-49.0f + fmaxf(1.0f, fminf(88.0f, float(fslider5)))))); // step: 160
		float 	fSlow10 = expf(-(fConst30 / fmaxf(0.001f, fminf(1e+01f, float(fslider6))))); // step: 166
		float 	fSlow11 = ((1.0f - fSlow10) * fSlow9); // step: 167
		float 	fVeeec12;
		float 	fVeeec11;
		float 	fVeeec15[2];
		int 	iSlow12 = (iSlow6 >= 3); // step: 189
