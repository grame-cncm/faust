		fbargraph12 = (fSlow47 + (2e+01f * log10f(fDpyCap2)));
		fbargraph13 = (fSlow47 + (2e+01f * log10f(fDpyCap1)));
		fbargraph14 = (fSlow47 + (2e+01f * log10f(fDpyCap0)));
	}
};


