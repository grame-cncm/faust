		float 	fSlow16 = (0.33333334f * fSlow5); // step: 349
		float 	fSlow17 = fmaxf(0.0f, fminf(1.0f, float(fslider9))); // step: 352
		float 	fVeeec38;
		float 	fVeeec40[2];
