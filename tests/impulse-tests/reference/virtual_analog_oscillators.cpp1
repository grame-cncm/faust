		float 	fVeeec17[2];
		float 	fVeeec18[2];
		float 	fVeeec19[2];
		float 	fVeeec20[2];
		float 	fSlow13 = (0.01f * fmaxf(-1e+01f, fminf(1e+01f, float(fslider7)))); // step: 239
