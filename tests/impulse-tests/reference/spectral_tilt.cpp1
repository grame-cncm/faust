	virtual void instanceResetUserInterface() {
		fslider0 = 1e+02f;
		fslider1 = 5e+03f;
		fslider2 = -0.5f;
		fcheckbox0 = 0.0;
		fslider3 = -2e+01f;
		fcheckbox1 = 0.0;
		fcheckbox2 = 0.0;
		fcheckbox3 = 0.0;
		fentry0 = 2.0f;
		fslider4 = 49.0f;
		fslider5 = 0.1f;
		fslider6 = -0.1f;
		fslider7 = 0.1f;
		fslider8 = 1e+02f;
		fslider9 = 5e+01f;
	}
