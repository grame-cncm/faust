			output30[i] = (FAUSTFLOAT)(fSlow26);  // Zone Exec Code
			output31[i] = (FAUSTFLOAT)(fSlow27);  // Zone Exec Code
			output32[i] = (FAUSTFLOAT)(fSlow30);  // Zone Exec Code
			output33[i] = (FAUSTFLOAT)(fSlow33);  // Zone Exec Code
			output34[i] = (FAUSTFLOAT)(fSlow34);  // Zone Exec Code
		}
		for (int k=0; k<count; k++) output7[k] = output6[k];
		for (int k=0; k<count; k++) output9[k] = output8[k];
	}
};


