# Separate entry point preserves the existing architecture test targets.
ARCH ?= ../../architecture
OUT ?= ../../build/combiner-control-tests
CXXFLAGS ?= -O2 -std=c++11 -ffp-contract=off
.PHONY: check float double
check: float double
float double:
	@mkdir -p $(OUT)
	$(CXX) $(CXXFLAGS) -DFAUSTFLOAT=$@ -I$(ARCH) combiner-control.cpp -o $(OUT)/combiner-control-$@
	$(OUT)/combiner-control-$@
