# LLVM used by the libfaust workflow (libfaust.yml), built by build-llvm.yml.
#
# Both workflows read this file: it is the only place where the version is
# chosen. A release is never replaced: building the same LLVM again (other
# options, other toolchain) increments FAUST_LLVM_REVISION. After a published
# build, copy its SHA256SUMS asset into .github/llvm/SHA256SUMS.
#
# The release is named llvm-<LLVM_VERSION>-<FAUST_LLVM_REVISION> and holds
# faust-llvm-<LLVM_VERSION>-<FAUST_LLVM_REVISION>-<platform>.tar.xz (.zip on
# Windows), each extracting to a single llvm/ directory.

LLVM_VERSION=23.1.3
# sha256 of llvm-project-23.1.3.src.tar.xz, as published with llvmorg-23.1.3
LLVM_SOURCE_SHA256=c44186a7762ed28954be72e5ff6df9808e0779d4f1bf014ecc4e7e211d31ee34
LLVM_TARGETS="AArch64;ARM;WebAssembly;X86"
FAUST_LLVM_REVISION=1
FAUST_LLVM_REPOSITORY=grame-cncm/faust

# Linux builds (LLVM and libfaust) run in the same manylinux image, so that
# the static LLVM libraries and libfaust share one toolchain and glibc 2.28.
MANYLINUX_TAG=2026.10.03-1
MACOSX_DEPLOYMENT_TARGET=10.15
