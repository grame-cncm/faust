# ==============================================================================
# Faust to Mojo architecture file for PortAudio and custom terminal GUI.
# Provides the definitons and the main entry point to make the DSP code
# generated by Faust interact with the PortAudio API and be controlled via
# the native C terminal GUI. Link gui/terminal/native/build/libtermgui.a.
# ==============================================================================
# First section of architecture provided code start.
# Imports the modules and the definitions of the architecture code.
# ==============================================================================

from conf import *
from help import *
from dsp import *
from gui import *
from meta import *
from audio.portaudio import *
from gui.terminal.terminal import TerminalGui
from gui.terminal.ffi import error_str

# ==============================================================================
# First section of architecture provided code end.
<<includeIntrinsic>>
<<includeclass>>
# ==============================================================================
# Faust generated DSP code end.
# ==============================================================================
# Second section of architecture provided code start.
# Defines the main entry point of the application.
# Initializes the dsp object, the audio driver, and the gui, starts the audio
# thread and blocks the main thread with the gui to allow the audio thread run
# the DSP code and be controlled via the gui.
# ==============================================================================

def main() -> None:
    comptime assert dfaust == F32.dtype, "Expected 32 bit float driver precision."
    var dsp = unsafe_alloc[mydsp](1)
    dsp.unsafe_write(mydsp())
    dsp[].init(SAMP_RATE)
    var gui = unsafe_alloc[TerminalGui](1)
    gui.unsafe_write(TerminalGui())
    dsp[].build_user_interface(gui[])
    var driver = unsafe_alloc[PortAudio](1)
    driver.unsafe_write(PortAudio())
    var err = gui[].check()
    if not err:
        err = driver[].init()
    if not err:
        err = driver[].start(dsp)
    if not err:
        err = gui[].run()
    # Every path, including open/start/run failure, unwinds in this order.
    # Restore the tty before potentially waiting for the audio driver to stop.
    var term = gui[].stop()
    var end = driver[].stop()
    if driver[].stream != None:
        # A failed close may leave the callback accessing DSP memory.
        print("PortAudio close failed:", end)
        return
    gui[].close()
    comptime assert conforms_to(TerminalGui, Deinitable), (
        "Terminal GUI owns widget strings."
    )
    gui.unsafe_deinit_pointee()
    gui.unsafe_free()
    driver.unsafe_free()
    dsp.unsafe_free()
    if not err:
        err = term
    if err:
        if err > 0:
            print(error_str(err))
        else:
            print("PortAudio error:", err)
        return
    if end:
        print("PortAudio error:", end)
        return
    print("done")

# ==============================================================================
# Second section of architecture provided code end.
# ==============================================================================
