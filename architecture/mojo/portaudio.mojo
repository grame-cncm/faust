# ------------------------------------------------------------------------------
# Faust to Mojo audio architecture file for PortAudio.
# Provides the definitons and the main entry point to make the DSP code
# generated by Faust interact with the PortAudio API.
# ------------------------------------------------------------------------------

from conf import *
from help import *
from dsp import FaustDsp
from gui import FaustGui
from meta import FaustMeta
from audio.portaudio import PortAudio, FaustFloat

def main() -> None:
    var dsp = alloc[mydsp](1)
    dsp[] = mydsp()
    dsp[].init(48_000)

    var driver = PortAudio()

    err = driver.init()
    if err:
        print(err)
        dsp.free()
        return

    err = driver.start(dsp[])
    if err:
        print(err)
        dsp.free()
        return

    try:
        _ = input()
    except e:
        print(e)
        return

    err = driver.stop()
    if err:
        print(err)
        dsp.free()
        return

    dsp.free()
    print("done")

# ------------------------------------------------------------------------------
# Architecture provided code ends here.
