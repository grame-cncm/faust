        print(err)
        return
    err = driver.start(dsp)
    if err:
        dsp.unsafe_free()
        print(err)
        return
    err = gui.run()
    if err:
        dsp.unsafe_free()
        print(err)
        return
    err = driver.stop()
    if err:
        dsp.unsafe_free()
        print(err)
        return
    dsp.unsafe_free()
    print("done")

