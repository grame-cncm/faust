#
# this makefile is intended to build a single static library embedding both faust 
# and the corresponding llvm libraries
#

MAKE ?= make

TMP    ?= __tmp_llvm_lib__
OUTPUT ?= lib/libfaustwithllvm.a

# start to determine the current platform
system := $(shell uname -s)

# The LLVM libraries come from LLVM_CONFIG (the llvm-config CMake used to
# compile libfaust, given on the command line) or else from every libLLVM*.a
# of LLVM_LIB_DIR. When neither is given, the llvm-config of the PATH is used.
# The command line sets them, hence the overrides below.
LLVM_CONFIG ?=
LLVM_LIB_DIR ?=
ifeq ($(strip $(LLVM_CONFIG)$(LLVM_LIB_DIR)),)
override LLVM_CONFIG := $(shell command -v llvm-config 2>/dev/null)
endif

ifneq ($(strip $(LLVM_CONFIG)),)
override LLVM_LIB_DIR := $(shell $(LLVM_CONFIG) --libdir)
INPUT        := $(shell $(LLVM_CONFIG) --libnames --link-static)
SYSLIBS      := $(shell $(LLVM_CONFIG) --link-static --system-libs)
else
INPUT := $(notdir $(wildcard $(LLVM_LIB_DIR)/libLLVM*.a))
ifeq ($(system), Darwin)
SYSLIBS ?= -lm -lz -lcurses -lxml2
else
SYSLIBS ?= -lpthread -ldl -lm -lz
endif
endif

# An archive without LLVM would link nowhere: stop instead of producing it.
ifeq ($(strip $(INPUT)),)
$(error No LLVM library found (LLVM_CONFIG='$(LLVM_CONFIG)', LLVM_LIB_DIR='$(LLVM_LIB_DIR)'))
endif

ifeq ($(system), Darwin)
NCURSES_PRIMARY_PREFIX := /usr/local/Cellar/ncurses
NCURSES_BACKUP1_PREFIX := /opt/homebrew/Cellar/ncurses
NCURSES_BACKUP2_PREFIX := /opt/local
NCURSES_SEARCH := $(shell find $(NCURSES_PRIMARY_PREFIX) -name libncurses.a 2>/dev/null | head -n1 || find $(NCURSES_BACKUP1_PREFIX) -name libncurses.a 2>/dev/null | head -n1 || find $(NCURSES_BACKUP2_PREFIX) -name libncurses.a 2>/dev/null | head -n1)

# Use libtool instead of ar on macOS
AR = libtool
ARFLAGS = -static -o
else
# Ubuntu or others
NCURSES_SEARCH := $(shell find /usr -name libncurses.a 2>/dev/null | head -n1)

AR = ar
ARFLAGS = rcs
endif

# ncurses is only embedded for an LLVM that needs it (terminfo, before LLVM 19).
ifneq ($(filter -lcurses -lncurses -ltinfo,$(SYSLIBS)),)
LIBNCURSES_PATH ?= $(NCURSES_SEARCH)
endif

ifneq ($(strip $(LIBNCURSES_PATH)),)
NCURSES_FOLDER := $(TMP)/libncurses.dir
else
NCURSES_FOLDER :=
endif

FOLDERS := $(INPUT:%.a=$(TMP)/%.dir) $(TMP)/libfaust.dir $(NCURSES_FOLDER)
# faust-config gets the system libraries of this LLVM. It is written next to
# the faust binary (bin/, installed from there by CMake) rather than over the
# tracked tools/faust-config: a modified source tree marks the build
# '-modified' and rebuilds it during 'make install'.
CONFIG_IN := ../tools/faust-config
CONFIG    := bin/faust-config

MAKEFILE := $(lastword $(MAKEFILE_LIST))

.PHONY: $(OUTPUT)

all: $(OUTPUT)
	$(MAKE) -f $(MAKEFILE) syslibs

$(OUTPUT): $(FOLDERS)
	@-[ -f $@ ] && rm -f $@ 
	$(AR) $(ARFLAGS) $(OUTPUT) $(TMP)/*/*.o 
	rm -rf $(TMP)

syslibs:
	mkdir -p $(dir $(CONFIG))
	sed -e "s|^SYSTEMLIBS..*|SYSTEMLIBS=\"$(SYSLIBS)\"|" $(CONFIG_IN) > $(CONFIG)
	chmod +x $(CONFIG)

##########################################
# Determine system for extraction handling
# (no PREFIX here: this makefile runs inside 'make install PREFIX=...', whose
# PREFIX reaches it through MAKEFLAGS)

ifeq ($(system), Darwin)
ARCH := $(shell uname -m)
# A universal library is thinned to the current architecture, a thin one is used as is.
EXTRACT = mkdir -p $@ && if lipo -info $< | grep -q '^Architectures in the fat file'; then lipo -thin $(ARCH) $< -o $@/thin.a; else cp $< $@/thin.a; fi && cd $@ && ar -x thin.a && rm thin.a
else
EXTRACT = mkdir -p $@ && cd $@ && ar -x $<
endif

$(TMP)/%.dir: $(LLVM_LIB_DIR)/%.a
	@-[ -d $@ ] && rm -rf $@ 
	$(EXTRACT)

$(TMP)/libfaust.dir: lib/libfaust.a
	@-[ -d $@ ] && rm -rf $@ 
	mkdir -p $@ && cd $@ && ar -x ../../$<

ifneq ($(strip $(LIBNCURSES_PATH)),)
# Add a new rule for extracting libncurses.a when available.
$(TMP)/libncurses.dir: $(LIBNCURSES_PATH)
	@-[ -d $@ ] && rm -rf $@
	mkdir -p $@ && cd $@ && ar -x $(LIBNCURSES_PATH)
endif
